# ==========================================
# FATHER'S RADIO — ENVIRONMENT VARIABLES (.env)
# ==========================================

# Station Owner Google Account (Authorized to edit global branding, theme, rain & playlists)
VITE_OWNER_EMAIL=your-owner-email@example.com
# Firebase Client Credentials (For Google Sign-In & Global Shared Firestore Database)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web App
VITE_OWNER_EMAIL=your-owner-email@example.com
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
